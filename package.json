{
  "name": "collect-everything",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p worker/tsconfig.json --pretty false && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty && tsc -p worker/tsconfig.json --pretty",
    "typecheck:worker": "tsc -p worker/tsconfig.json --pretty",
    "test": "vitest run && python -m unittest discover -s scripts -p test_import_srg_workbook.py",
    "catalog:fftcg": "node scripts/import-fftcg-catalog.mjs",
    "catalog:union-arena": "node scripts/import-union-arena-catalog.mjs",
    "deploy:worker": "npm run build && wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
