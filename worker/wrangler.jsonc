  "vars": {
    "GITHUB_ALLOWED_LOGIN": "mirpkered",
    "GITHUB_APP_CLIENT_ID": "Iv23liYFY7rywabIUvs9",
    "GITHUB_REPO_OWNER": "mirpkered",
    "GITHUB_REPO_NAME": "collect-everything-data",
    "GITHUB_REPO_BRANCH": "main"
  }
}
